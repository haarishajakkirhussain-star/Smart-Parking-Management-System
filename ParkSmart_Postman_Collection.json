      "item": [
        {
          "name": "Get All Floors and Zones",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/floors",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "floors"]
            }
          }
        },
        {
          "name": "Get Slots by Floor ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/grid/slots?floorId=2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "grid", "slots"],
              "query": [{ "key": "floorId", "value": "2" }]
